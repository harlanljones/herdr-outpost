# ==============================================================================
# herdr-outpost Environment Configuration Template
# ==============================================================================
# Copy this file to ~/.config/herdr-outpost/config.env or .env in your working dir
# and adjust the values for your deployment.
#
# Environment variables use the HERDR_OUTPOST_* prefix, with fallback to HERDR_*
# for backward compatibility.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Relay Daemon Settings
# ------------------------------------------------------------------------------
# Host interface and port for the local WebSocket/HTTP relay daemon
HERDR_OUTPOST_RELAY_HOST=127.0.0.1
HERDR_OUTPOST_RELAY_PORT=8375

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
HERDR_OUTPOST_LOG_LEVEL=INFO

# Agent state polling interval in seconds (herdr pane list refresh)
# HERDR_OUTPOST_POLL_INTERVAL=3.0

# Session reconciliation TTL in seconds: hook/UDP-only reporters that never
# appear in `herdr agent list` expire after this long without an observation
# (legacy fallback: HERDR_SESSION_TTL)
# HERDR_OUTPOST_SESSION_TTL=90

# Live terminal output streaming: how often subscribed panes are captured and
# pushed to dashboard clients (only when content changes), and how many lines
# each pane_output frame contains.
# HERDR_OUTPOST_OUTPUT_INTERVAL=2.0
# HERDR_OUTPOST_OUTPUT_LINES=300

# Optional custom log directory. Default locations:
# Linux:   ~/.local/state/herdr-outpost/log
# macOS:   ~/Library/Logs/herdr-outpost
# Windows: %LOCALAPPDATA%\herdr-outpost\logs
# HERDR_OUTPOST_LOG_DIR=~/.local/state/herdr-outpost/log

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
# Shared bearer token for authenticating dashboard clients and webhook events.
# Generate a secure token with: openssl rand -hex 32
HERDR_OUTPOST_RELAY_TOKEN=replace_with_a_secure_random_token_32_bytes

# Comma-separated list of allowed WebSocket and HTTP Origins (CORS / CSWSH protection).
# Connections with an Origin header not in this list will be rejected with 403 Forbidden.
HERDR_OUTPOST_TRUSTED_ORIGINS="https://herdr.example.com,https://relay.example.com,http://localhost:8375"

# ------------------------------------------------------------------------------
# 3. Cloudflare Tunnel Settings
# ------------------------------------------------------------------------------
# Tunnel mode: 'named' (uses cloudflared config) or 'quick' (trycloudflare ephemeral URL)
HERDR_OUTPOST_TUNNEL_MODE=named

# Name of your Cloudflare Tunnel
HERDR_OUTPOST_TUNNEL_NAME=herdr-outpost

# Path to Cloudflare Tunnel configuration file (optional, defaults to standard locations)
# HERDR_OUTPOST_TUNNEL_CONFIG=~/.cloudflared/config-herdr-outpost.yml

# ------------------------------------------------------------------------------
# 4. Multi-Host / Remote Monitoring
# ------------------------------------------------------------------------------
# Comma-separated list of remote SSH hosts to poll for herdr agents (optional).
# Ensure SSH keys / agent forwarding are configured so `ssh user@host herdr ...` works.
# HERDR_OUTPOST_REMOTES="user@dev-server.com,user@prod-server.com"

# ------------------------------------------------------------------------------
# 5. Telegram Bot Integration (Optional)
# ------------------------------------------------------------------------------
# Telegram Bot API token obtained from @BotFather
# HERDR_OUTPOST_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Authorized Telegram Chat ID (your personal chat or group ID)
# HERDR_OUTPOST_TELEGRAM_CHAT_ID=987654321

# Events triggering Telegram alerts (comma-separated: blocked, done, error, prompt)
# HERDR_OUTPOST_TELEGRAM_NOTIFY_EVENTS="blocked,done,error"

# ------------------------------------------------------------------------------
# 6. Web Push (VAPID) Settings (Optional)
# ------------------------------------------------------------------------------
# VAPID keys for browser Web Push notifications (generate via web-push or pywebpush)
# HERDR_OUTPOST_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa...
# HERDR_OUTPOST_VAPID_PRIVATE_KEY=y8...
# HERDR_OUTPOST_VAPID_SUBJECT="mailto:admin@example.com"

# ------------------------------------------------------------------------------
# 7. Backward Compatibility Fallbacks (HERDR_*)
# ------------------------------------------------------------------------------
# If HERDR_OUTPOST_* variables are unset, the relay checks these legacy names:
# HERDR_RELAY_HOST=127.0.0.1
# HERDR_RELAY_PORT=8375
# HERDR_RELAY_TOKEN=replace_with_a_secure_random_token
# HERDR_TRUSTED_ORIGINS="https://herdr.example.com,https://relay.example.com"
# HERDR_TUNNEL_MODE=named
# HERDR_TUNNEL_NAME=herdr-outpost
# HERDR_REMOTES="user@dev-server.com"
